# Copia este archivo a .env para desarrollo local. En Render, estas mismas
# claves se configuran como variables de entorno del servicio (nunca en el
# repositorio).

# Postgres (Render Postgres). Sin esto, la web arranca en modo memoria: sirve
# para probar la portada, pero no hay historial, tickets ni panel de admin.
DATABASE_URL=

# Secreto de las cookies de sesion. Genera uno largo y aleatorio.
SESSION_SECRET=

# Cuenta de administrador. Se crea/actualiza automaticamente al arrancar
# (ver db/seedAdmin.js). Solo puede haber un admin: el resto de cuentas con
# rol admin se degradan a 'user'. Minimo 12 caracteres en la contrasena.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Envio de correos de verificacion (Resend, https://resend.com).
# Sin RESEND_API_KEY, el registro sigue funcionando pero el correo de
# confirmacion no se envia (se avisa por log) y nadie puede validar su cuenta.
RESEND_API_KEY=
# Remitente. Por defecto usa onboarding@resend.dev (no requiere dominio propio).
# Cuando verifiques tu dominio en Resend, cambia esto por algo como:
# RESEND_FROM="Pescata Dev <no-reply@tudominio.com>"
RESEND_FROM=

# Stripe (checkout, opcional por ahora).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
