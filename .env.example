# Copia este fichero como .env y rellena los valores reales (no se commitea)

# Puerto local (Render lo asigna solo en produccion)
PORT=3000

# Sesiones (cadena aleatoria larga)
SESSION_SECRET=cambia-esto-por-algo-aleatorio

# Base de datos (Postgres). En local puedes usar SQLite o un Postgres local.
DATABASE_URL=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Discord (para activar canales/roles al contratar, y el bot de pedidos personalizados)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ORDERS_CHANNEL_ID=
