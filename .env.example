# Copia este archivo a .env para desarrollo local. En Render, estas mismas
# claves se configuran como variables de entorno del servicio (nunca en el
# repositorio).

# Postgres (Render Postgres). Sin esto, la web arranca en modo memoria: sirve
# para probar la portada, pero no hay historial, tickets ni panel de admin.
DATABASE_URL=

# Secreto de las cookies de sesion. Genera uno largo y aleatorio.
SESSION_SECRET=

# Cuenta de administrador (ver db/seedAdmin.js). Al arrancar, la cuenta
# ADMIN_EMAIL pasa a ser admin y queda verificada; si ya existe NO se cambia su
# contrasena. ADMIN_PASSWORD (minimo 12 caracteres) solo se usa para crearla
# cuando todavia no existe. Solo puede haber un admin: el resto de cuentas con
# rol admin se degradan a 'user'.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Las cuentas nuevas quedan pendientes y el admin las aprueba a mano desde
# Clientes. No se envia ningun correo (Resend eliminado).

# Stripe (checkout, opcional por ahora).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
